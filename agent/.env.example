# Copy to .env and fill in — never commit the real file.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Points at the SAME sqlite file the Flask backend uses. Default resolves
# to ../backend/carbon.db relative to this service — override if you move
# the DB or migrate to MySQL later.
CARBON_DB_PATH=D:/Desktop/carbon-platform/backend/carbon.db
